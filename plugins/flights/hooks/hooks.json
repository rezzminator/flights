{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/codebase_map\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/codebase_map\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/codebase_map\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
